ORCHESTRATOR_API_KEY=replace-with-a-long-random-key
# Optional separate admin key for /admin/* endpoints. Falls back to
# ORCHESTRATOR_API_KEY when empty. Use a different long random key in shared setups.
ORCHESTRATOR_ADMIN_API_KEY=
ORCHESTRATOR_BIND_IP=127.0.0.1
ORCHESTRATOR_PORT=8090
ORCHESTRATOR_LOG_LEVEL=INFO
ORCHESTRATOR_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ORCHESTRATOR_IMAGE=local/local-llm-orchestrator:latest
# Optional: also append every admin config change to this file as JSON lines, so the
# record survives a container restart (the in-app audit view is memory-only). Use a
# path under the mounted ./config dir to keep it on the host. Leave empty to disable.
AUDIT_LOG_PATH=

LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server
LLAMA_CPP_CUDA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
LLAMA_MODELS_MAX=2
LLAMA_SLEEP_IDLE_SECONDS=900
REQUEST_TIMEOUT_SECONDS=300

# Optional single-model services (compose profile "models"). Point these at the
# GGUF files under ./models for the main and prompt models.
LLAMA_MAIN_MODEL=chat/gemma-4-E2B-it-Uncensored-MAX.Q4_K_S.gguf
LLAMA_PROMPT_MODEL=prompt/LFM2.5-1.2B-Instruct-Q8_0.gguf
# Route the main/prompt models to their dedicated containers so the console toggle
# actually turns inference on/off. Leave these UNSET to keep using llama-router
# (safe default). Only set them after bringing the services up with --profile models,
# otherwise those models will be unreachable.
# LLAMA_MAIN_URL=http://llama-main:8080
# LLAMA_PROMPT_URL=http://llama-prompt:8080
# Context window (tokens) for llama-main and llama-prompt. Higher values raise
# each loaded model's KV-cache memory roughly linearly -- check headroom
# (docker stats) before raising this, especially if other models can also be
# loaded concurrently via llama-router.
LLAMA_CTX_SIZE=8192
# Runtime start/stop of those services from the admin console. Requires the
# compose.docker-control.yaml overlay (mounts the Docker socket). Keep false
# unless you understand that socket access is roughly host root.
DOCKER_CONTROL_ENABLED=false
DOCKER_COMPOSE_PROJECT=local-llm

MCP_ENABLED=false
MCP_SERVER_URL=http://host.docker.internal:8765/mcp
MCP_TOOL_ALLOWLIST=route_request,build_agent_context,load_skill,load_workflow,list_toolsets,get_toolset

