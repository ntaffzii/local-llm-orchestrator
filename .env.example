LLAMA_SERVER_EXE=llama-server
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080
LLAMA_MODELS_MAX=2
LLAMA_CTX_SIZE=8192
LLAMA_SLEEP_IDLE_SECONDS=900

ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=8090
# Keep this at 1 unless you front the service with a real rate limiter: the auth
# lockout and per-key rate limits are in-process, so each extra worker multiplies
# the effective thresholds (4 workers = ~4x the allowed failures/requests).
ORCHESTRATOR_WORKERS=1
ORCHESTRATOR_API_KEY=change-me
# Optional: a separate key for /admin/* endpoints. If unset, the admin APIs
# fall back to ORCHESTRATOR_API_KEY. Set this to a different long random value
# to stop inference clients from being able to rewrite routing and config.
ORCHESTRATOR_ADMIN_API_KEY=
LLAMA_BASE_URL=http://127.0.0.1:8080
MODEL_CONFIG_PATH=./config/models.json
REQUEST_TIMEOUT_SECONDS=300
ORCHESTRATOR_LOG_LEVEL=INFO
ORCHESTRATOR_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set true only when running behind a trusted reverse proxy that sets
# X-Forwarded-For, so auth rate-limiting keys on the real client IP.
TRUST_FORWARDED_FOR=false
# Set false to disable the /admin/ui console entirely (e.g. in production).
ADMIN_UI_ENABLED=true
# Optional: also append every admin config change to this file as JSON lines. The
# in-app audit view is memory-only and is lost on restart; set this to keep a record
# that survives the process. Leave empty to disable.
AUDIT_LOG_PATH=

MCP_ENABLED=false
MCP_SERVER_URL=http://127.0.0.1:8765/mcp
MCP_TOOL_ALLOWLIST=
